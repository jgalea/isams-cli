def cmd_login(args):
    sess = sign_in(school_host(args.school) if args.school else None)
    print(f"Signed in to {sess['school']} as {sess.get('name') or sess.get('email')}.")


def cmd_logout(args):
    for path in (SESSION, COOKIES):
        if os.path.exists(path):
            os.remove(path)
    print("Signed out; the saved session is deleted.")


def cmd_whoami(args):
    sess = session()
    info = {"school": sess["school"], "name": sess.get("name"), "email": sess.get("email"),
            "children": [f"{k.get('fullName')} ({k.get('formGroup')})" for k in kids()]}

    def render(d):
        print(f"{d['name']} <{d['email']}> at {d['school']}.isams.cloud")
        for c in d["children"]:
            print(f"  {clean(c)}")
    out(args, info, render)


def cmd_kids(args):
    def render(data):
        for k in data:
            print(f"{clean(k.get('fullName'))}  form {k.get('formGroup')}  "
                  f"{clean(k.get('yearGroup') and 'year ' + str(k.get('yearGroup')))}  "
                  f"house {clean(k.get('academicHouse'))}  id {k.get('schoolId')}")
