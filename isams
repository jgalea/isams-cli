def timetable_for(kid):
    sid = kid["schoolId"]
    lessons = api(f"portals/students/{sid}/timetables/periods").get("timetablePeriods", [])
    slots = api(f"portals/students/{sid}/timetables/weeks").get("timetableWeeks", [])
    wanted = {l["period"] for l in lessons}
    slots = [s for s in slots if s["periodId"] in wanted]
    active = {s["currentActiveWeekId"] for s in slots}
    by_period = {s["periodId"]: s for s in slots}
    merged = {}
    for l in lessons:
        slot = by_period.get(l["period"])
        if not slot:
            continue
        key = (l["period"], l.get("subject"))
        row = merged.setdefault(key, {
            "week": slot["weekName"], "week_id": slot["weekId"],
            "current_week": slot["weekId"] in active,
            "day": slot["dayName"], "day_order": slot["dayOrder"],
            "start": hhmm(slot["periodStartTime"]), "end": hhmm(slot["periodEndTime"]),
            "period": clean(slot["perdiodName"]), "subject": clean(l.get("subject")),
            "room": clean(l.get("className")), "teachers": []})
        teacher = clean(l.get("staffFullname"))
        if teacher and teacher not in row["teachers"]:
            row["teachers"].append(teacher)
    return sorted(merged.values(), key=lambda r: (r["week_id"], r["day_order"], r["start"]))


def cmd_timetable(args):
    target = parse_date(args.day) if args.day else None
    if args.week:
        target = None
    elif not args.day:
        target = today()
    wanted_day = target.strftime("%A") if target else None

    def fetch(kid):
        rows = timetable_for(kid)
        if len({r["week_id"] for r in rows}) > 1 and not args.all_weeks:
            rows = [r for r in rows if r["current_week"]]
        if wanted_day:
            rows = [r for r in rows if r["day"] == wanted_day]
        return rows

    def render(kid, rows):
        if not rows:
            print(f"No lessons on {wanted_day}." if wanted_day else "No timetable on file.")
            return
        day = None
        for r in rows:
            if r["day"] != day:
                day = r["day"]
                label = f"{day} {target.isoformat()}" if target else day
                print(f"{label}" + (f"  [{r['week']}]" if args.all_weeks else ""))
            print(f"  {r['start']}-{r['end']}  {r['subject'][:30]:<30} {r['room'][:18]:<18} "
                  f"{', '.join(r['teachers'])}")
    per_kid(args, fetch, render)


def cmd_calendar(args):
    start = parse_date(args.start) if args.start else today()
    end = start + timedelta(days=args.days)
    data = api(f"portals/calendar/events?targetId=2&startDate={start}&endDate={end}")
    # The server ignores endDate and returns the rest of the year.
    data = [e for e in data if (d := day_of(e.get("startDate"))) and start <= d < end]
    if args.search:
        s = args.search.lower()
        data = [e for e in data if s in (e.get("description") or "").lower()
                or s in (e.get("category") or "").lower()]
    data.sort(key=lambda e: (e.get("startDate") or "", e.get("startTime") or ""))

    def render(events):
        if not events:
            print(f"Nothing on the school calendar from {start} to {end}.")
            return
        day = None
        for e in events:
            d = day_of(e.get("startDate"))
            if d != day:
                day = d
                print(f"{d:%a %d %b}")
            when = "all day" if e.get("allDayEvent") else \
                f"{hhmm(e.get('startTime'))}-{hhmm(e.get('endTime'))}".rstrip("-")
            until = day_of(e.get("endDate"))
            if until and until != d:
                when += f" until {until:%a %d %b}"
            place = f" @ {clean(e['location'])}" if clean(e.get("location")) else ""
            print(f"  {when:<13} {clean(e.get('description'))}{place}  "
                  f"[{clean(e.get('category'))}]")
    out(args, data, render)


def cmd_attendance(args):
    term = current_term()

    def fetch(kid):
        return api(f"portals/students/{kid['schoolId']}/terms/{term['id']}"
                   f"/attendancerecords/registration").get("attendanceRecords", [])

    def render(kid, rows):
        marks = [r for r in rows if r.get("code")]
        late = [r for r in rows if r.get("late")]
        print(f"{term['name']} {term['schoolYear']}: {len(rows)} registrations, "
              f"{len(marks)} marked, {len(late)} late")
        for r in marks + [r for r in late if r not in marks]:
            when = (r.get("registrationDateTime") or "")[:10]
            status = clean(r.get("registrationStatus"))
            extra = f", {r['minutesLate']} min late" if r.get("late") else ""
            print(f"  {when} {r.get('ampm', '')}  {status} ({r.get('code') or '-'}): "
                  f"{clean(r.get('reason'))}{extra}  by {clean(r.get('registeredBy'))}")
    per_kid(args, fetch, render)


def cmd_teachers(args):
    def fetch(kid):
        sid = kid["schoolId"]
        # Teaching groups carry no email addresses; the timetable does.
        emails = {clean(l.get("staffSurname")).lower(): l.get("staffEmailAddress")
                  for l in api(f"portals/students/{sid}/timetables/periods").get("timetablePeriods", [])
                  if l.get("staffEmailAddress")}
        rows = []
        for g in api(f"portals/students/{sid}/teachinggroups").get("teachingGroups", []):
            staff = [g.get("teacher") or {}] + list(g.get("associatedTeachers") or [])
            rows.append({"subject": clean(g.get("subjectName")),
                         "teachers": [{"name": clean(f"{t.get('title') or ''} {t.get('firstname') or ''} {t.get('surname') or ''}"),
                                       "email": t.get("schoolEmailAddress") or emails.get(clean(t.get("surname")).lower())}
                                      for t in staff if t.get("surname")]})
        return sorted(rows, key=lambda r: r["subject"])

    def render(kid, rows):
        for r in rows:
            people = "; ".join(t["name"] + (f" <{t['email']}>" if t["email"] else "")
                               for t in r["teachers"])
            print(f"  {r['subject'][:30]:<30} {people}")
    per_kid(args, fetch, render)


def cmd_homework(args):
    status = {"all": None, "outstanding": 0, "submitted": 1, "completed": 2}[args.status]

    def fetch(kid):
        f = f"SchoolId eq '{kid['schoolId']}'"
        if status is not None:
            f += f" and SubmissionStatus eq '{status}'"
        q = urllib.parse.urlencode({"$filter": f, "page": 1, "pageSize": args.limit,
                                    "$orderby": "DueDate desc"})
        return api(f"portal/homework?{q}").get("homework", [])

    def render(kid, items):
        if not items:
            print("  No homework on the portal." if args.status == "all"
                  else f"  No {args.status} homework.")
        for h in items:
            due = (h.get("dueDate") or h.get("DueDate") or "")[:10]
            title = clean(h.get("title") or h.get("name") or h.get("description"))
            subject = clean(h.get("subjectName") or h.get("subject") or "")
            print(f"  due {due}  {subject:<18} {title}")
    per_kid(args, fetch, render)


def cmd_reports(args):
    def fetch(kid):
        sid = kid["schoolId"]
        return {"reports": api(f"portals/students/{sid}/schoolreports/reports?$orderby=PublishedOn desc").get("reports", []),
                "assessments": api(f"portals/students/{sid}/schoolreports/assessments?$orderby=PublishedOn desc").get("assessments", [])}

    def render(kid, d):
        if not d["reports"] and not d["assessments"]:
            print("  No published reports or assessments yet.")
        for kind in ("reports", "assessments"):
            for r in d[kind]:
                print(f"  {kind[:-1]:<10} {(r.get('publishedOn') or '')[:10]}  "
                      f"{clean(r.get('name') or r.get('title'))}  id {r.get('id')}")
    per_kid(args, fetch, render)


def cmd_docs(args):
    if args.search:
        q = urllib.parse.quote(args.search)
        data = api(f"portals/documents/search?searchTerm={q}").get("documents", [])
    elif args.folder is not None:
        data = api(f"portals/documents/folders/{args.folder}/documents").get("documents", [])
    else:
        data = api("portals/documents/latest").get("documents", [])

    def render(docs):
        if not docs:
            print("No documents.")
        for d in docs:
            size = int(d.get("fileSize") or 0) // 1024
            meta = d.get("fileType") + (f", {size} KB" if size else "")
            print(f"{d.get('documentId'):>7}  {(d.get('submitDateTime') or '')[:10]}  "
                  f"{clean(d.get('displayName'))}  ({meta})")
    out(args, data, render)


def cmd_folders(args):
    folders = api("portals/documents/folders/-1").get("folders", [])

    def render(data):
        children = {}
        for f in data:
            children.setdefault(f.get("parentFolderId"), []).append(f)
        ids = {f["folderId"] for f in data}

        def walk(parent, depth):
            for f in sorted(children.get(parent, []), key=lambda f: (f.get("order") or 0, f["folderName"])):
                print(f"{'  ' * depth}{clean(f['folderName'])}  [{f['folderId']}]")
                walk(f["folderId"], depth + 1)
        for root in sorted({f.get("parentFolderId") for f in data} - ids, key=lambda x: x or 0):
            walk(root, 0)
    out(args, folders, render)


def cmd_download(args):
    body, headers = api(f"portals/documents/{args.id}/commands/download", raw=True)
    m = re.search(r'filename="?([^";]+)"?', headers.get("Content-Disposition") or "")
    name = os.path.basename(m.group(1)) if m else f"document-{args.id}"
    name = re.sub(r"[\x00-\x1f/\\]", "_", name)
    path = os.path.join(os.path.expanduser(args.dir), name)
    with open(path, "wb") as f:
        f.write(body)
    print(path)


def cmd_invoices(args):
    def render(d):
        if not d:
            print("No invoices on the portal.")
        for i in d:
            print(json.dumps(i, ensure_ascii=False))
    out(args, api("portals/invoices").get("invoices", []), render)


def cmd_forms(args):
    data = {"pending": api("portals/electronicforms/pending").get("electronicForms", []),
            "available": api("portals/electronicforms").get("availableElectronicForms", []),
            "submitted": api("portals/electronicforms/history").get("electronicForms", [])}

    def render(d):
        print(f"Pending ({len(d['pending'])})")
        for f in d["pending"]:
            print(f"  {f.get('id'):>5}  {clean(f.get('name'))}")
        print(f"Available ({len(d['available'])})")
        for f in d["available"]:
            desc = f"  - {clean(f['description'])}" if clean(f.get("description")) else ""
            print(f"  {f.get('id'):>5}  {clean(f.get('name'))}{desc}")
        print(f"Submitted ({len(d['submitted'])})")
        for f in d["submitted"]:
            print(f"  {f.get('id'):>5}  {(f.get('submittedOn') or '')[:10]}  {clean(f.get('name'))}")
    out(args, data, render)


def cmd_raw(args):
    json.dump(api(args.path), sys.stdout, indent=2, ensure_ascii=False)
    print()


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="raw JSON output")
    kid = argparse.ArgumentParser(add_help=False)
    kid.add_argument("child", nargs="?", help="a child's name or form (default: all)")

    p = argparse.ArgumentParser(prog="isams", parents=[common],
                                description="iSAMS parent portal from the terminal")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("login", help="sign in and remember the session", parents=[common])
    s.add_argument("--school", help="the SCHOOL in SCHOOL.parents.isams.cloud")
    s.set_defaults(fn=cmd_login)
    sub.add_parser("logout", help="delete the saved session", parents=[common]).set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", help="who is signed in, and the children", parents=[common]).set_defaults(fn=cmd_whoami)
    sub.add_parser("kids", help="your children on file", parents=[common]).set_defaults(fn=cmd_kids)

    s = sub.add_parser("timetable", help="lessons for a day (default today) or the week",
                       parents=[common, kid])
    s.add_argument("-d", "--day", help="today, tomorrow, a weekday or YYYY-MM-DD")
    s.add_argument("-w", "--week", action="store_true", help="the whole week")
    s.add_argument("--all-weeks", action="store_true", help="every rota week (A/B), not just the current one")
    s.set_defaults(fn=cmd_timetable)

    s = sub.add_parser("calendar", help="the school calendar", parents=[common])
    s.add_argument("--from", dest="start", help="start date (default today)")
    s.add_argument("--days", type=int, default=14, help="how far ahead (default 14)")
    s.add_argument("-s", "--search", help="only events matching this text")
    s.set_defaults(fn=cmd_calendar)

    s = sub.add_parser("attendance", help="this term's absences and lates", parents=[common, kid])
    s.set_defaults(fn=cmd_attendance)

    s = sub.add_parser("teachers", help="subjects and who teaches them", parents=[common, kid])
    s.set_defaults(fn=cmd_teachers)

    s = sub.add_parser("homework", help="homework set on the portal", parents=[common, kid])
    s.add_argument("--status", choices=["outstanding", "submitted", "completed", "all"], default="all")
    s.add_argument("-n", "--limit", type=int, default=20)
    s.set_defaults(fn=cmd_homework)

    s = sub.add_parser("reports", help="published reports and assessments", parents=[common, kid])
    s.set_defaults(fn=cmd_reports)

    s = sub.add_parser("docs", help="latest documents, a folder, or a search", parents=[common])
    s.add_argument("-s", "--search", help="search document names")
    s.add_argument("-f", "--folder", type=int, help="folder id, from 'isams folders'")
    s.set_defaults(fn=cmd_docs)

    sub.add_parser("folders", help="the document folder tree", parents=[common]).set_defaults(fn=cmd_folders)

    s = sub.add_parser("download", help="save a document", parents=[common])
    s.add_argument("id", help="document id, from 'isams docs'")
    s.add_argument("--dir", default=".", help="where to save it (default here)")
    s.set_defaults(fn=cmd_download)

    s = sub.add_parser("activities", help="after-school clubs, from SOCS", parents=[common, kid])
    s.add_argument("--sessions", action="store_true", help="list every session date")
    s.set_defaults(fn=cmd_activities)

    sub.add_parser("invoices", help="invoices on the portal", parents=[common]).set_defaults(fn=cmd_invoices)
    sub.add_parser("forms", help="electronic forms to fill in", parents=[common]).set_defaults(fn=cmd_forms)

    s = sub.add_parser("raw", help="GET any API path, e.g. portals/schools/terms", parents=[common])
    s.add_argument("path")
    s.set_defaults(fn=cmd_raw)

    args = p.parse_args()
    args.json = getattr(args, "json", False)
    if not hasattr(args, "child"):
        args.child = None
    try:
        args.fn(args)
    except ApiError as e:
        sys.exit(str(e))
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
